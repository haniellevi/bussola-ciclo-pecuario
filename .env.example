# Modelo padrão do chat no OpenRouter (o usuário também pode escolher no próprio chat)
MODELO_AGENTE=

# Chave do OpenRouter usada pelo servidor (o chat funciona sem colar chave no navegador).
# Atenção: em site público, cada visitante gasta os seus créditos. Limite por visitante abaixo.
OPENROUTER_API_KEY=
CHAT_LIMITE_HORA=20

# Modelo que lê as notícias no robô semanal (ex.: o Jev no OpenRouter). No GitHub: variável MODELO_NOTICIAS e segredo OPENROUTER_API_KEY.
MODELO_NOTICIAS=
